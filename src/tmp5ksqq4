use anyhow::{bail, Context, Result};
use clap::{ArgAction, Args, CommandFactory, Parser, Subcommand, ValueEnum};
use clap_version_flag::colorful_version;
use clap_color_help::default_styles;
use clap_complete::Shell;
use png2ico::inputs::collect_inputs;
use png2ico::{
    convert_file, read_directory, Color, Encoding, EntryFormat, Fit, Layout, Options, Plan,
    SIZES_ALL, SIZES_FAVICON, SIZES_WINDOWS,
};
use rayon::prelude::*;
use std::ffi::OsString;
use std::path::PathBuf;
use std::process::ExitCode;
use tracing::Level;

/// Convert images (PNG, JPEG, WebP, BMP, GIF, TIFF) to ICO with multiple sizes.
///
/// For backward compatibility `png2ico logo.png -S` is the same as
/// `png2ico convert logo.png -S`.
#[derive(Parser)]
#[command(name = "png2ico", version, about, arg_required_else_help = true, disable_version_flag = true, styles=default_styles())]
struct Cli {
    /// Increase log verbosity (-v info, -vv debug, -vvv trace)
    #[arg(short, long, action = ArgAction::Count, global = true)]
    verbose: u8,

    /// Only print errors
    #[arg(short, long, global = true)]
    quiet: bool,

    #[command(subcommand)]
    command: Command,
}

#[derive(Subcommand)]
enum Command {
    /// Convert images to ICO (default command)
    Convert(ConvertArgs),
    /// Show the images stored inside ICO files
    Inspect {
        #[arg(required = true, value_name = "ICO")]
        files: Vec<PathBuf>,
    },
    /// List size presets
    Sizes,
    /// Generate shell completions
    Completions {
        #[arg(value_enum)]
        shell: Shell,
    },
}

#[derive(Clone, Copy, ValueEnum)]
enum PresetArg {
    /// 16 20 24 32 40 48 64 72 96 128 256
    All,
    /// 16 24 32 48 64 128 256
    Windows,
    /// 16 32 48
    Favicon,
}

impl PresetArg {
    fn sizes(self) -> &'static [u32] {
        match self {
            Self::All => SIZES_ALL,
            Self::Windows => SIZES_WINDOWS,
            Self::Favicon => SIZES_FAVICON,
        }
    }
}

#[derive(Clone, Copy, ValueEnum)]
enum FitArg {
    /// Keep aspect ratio, pad with transparency
    Contain,
    /// Keep aspect ratio, fill and center-crop
    Cover,
    /// Stretch to a square
    Stretch,
}

#[derive(Clone, Copy, ValueEnum)]
enum EncodingArg {
    /// BMP for small sizes, PNG for 256px (most compatible)
    Auto,
    /// PNG for every size (smallest, Vista+)
    Png,
    /// BMP for every size (legacy)
    Bmp,
}

#[derive(Args)]
struct ConvertArgs {
    /// Image files, directories or glob patterns (e.g. "icons/*.png")
    #[arg(required = true, value_name = "INPUT")]
    inputs: Vec<String>,

    /// Custom sizes, comma separated or repeated: -s 16,32,64 (max 256)
    #[arg(short, long, value_delimiter = ',', num_args = 1, value_parser = parse_size)]
    sizes: Vec<u32>,

    /// Size preset (ignored when --sizes is given)
    #[arg(short, long, value_enum, default_value_t = PresetArg::All)]
    preset: PresetArg,

    /// Write one multi-size ICO instead of one file per size
    #[arg(short = 'S', long, alias = "one-file")]
    single: bool,

    /// Output file (requires --single and exactly one input)
    #[arg(short, long, requires = "single")]
    output: Option<PathBuf>,

    /// Output directory (default: next to each input)
    #[arg(short = 'd', long)]
    out_dir: Option<PathBuf>,

    /// How to fit non-square images
    #[arg(long, value_enum, default_value_t = FitArg::Contain)]
    fit: FitArg,

    /// Margin per side in percent of icon size (0-45)
    #[arg(long, default_value_t = 0.0, value_parser = parse_padding)]
    padding: f32,

    /// Background color: #RGB, #RRGGBB, #RRGGBBAA, white, black, transparent
    #[arg(long)]
    background: Option<Color>,

    /// Encoding of entries inside the ICO
    #[arg(long, value_enum, default_value_t = EncodingArg::Auto)]
    encoding: EncodingArg,

    /// Skip sizes larger than the source image
    #[arg(long)]
    no_upscale: bool,

    /// Overwrite existing files
    #[arg(short, long)]
    force: bool,

    /// Show what would be written without writing
    #[arg(short = 'n', long)]
    dry_run: bool,

    /// Recurse into directories
    #[arg(short, long)]
    recursive: bool,

    /// Number of worker threads (default: all cores)
    #[arg(short, long)]
    jobs: Option<usize>,
}

fn parse_size(s: &str) -> Result<u32, String> {
    let t = s.trim().to_ascii_lowercase();
    let n = t.split('x').next().unwrap_or("");
    match n.parse::<u32>() {
        Ok(v) if v >= 1 => Ok(v),
        _ => Err(format!("`{s}` is not a valid size (expected e.g. 32 or 32x32)")),
    }
}

fn parse_padding(s: &str) -> Result<f32, String> {
    match s.parse::<f32>() {
        Ok(v) if (0.0..=45.0).contains(&v) => Ok(v),
        _ => Err("padding must be a number between 0 and 45".to_string()),
    }
}

fn human(bytes: u64) -> String {
    if bytes < 1024 {
        format!("{bytes} B")
    } else {
        format!("{:.1} KiB", bytes as f64 / 1024.0)
    }
}

fn run_convert(a: ConvertArgs, quiet: bool) -> Result<ExitCode> {
    if let Some(n) = a.jobs {
        let _ = rayon::ThreadPoolBuilder::new().num_threads(n.max(1)).build_global();
    }

    let collected = collect_inputs(&a.inputs, a.recursive);
    let mut failures = 0usize;
    for m in &collected.missing {
        eprintln!("  ✗ no such file or no images found: {m}");
        failures += 1;
    }
    if collected.files.is_empty() {
        bail!("no input images to convert");
    }
    if a.output.is_some() && collected.files.len() != 1 {
        bail!("--output can only be used with exactly one input file");
    }

    let opts = Options {
        sizes: if a.sizes.is_empty() { a.preset.sizes().to_vec() } else { a.sizes.clone() },
        fit: match a.fit {
            FitArg::Contain => Fit::Contain,
            FitArg::Cover => Fit::Cover,
            FitArg::Stretch => Fit::Stretch,
        },
        padding: a.padding,
        background: a.background,
        encoding: match a.encoding {
            EncodingArg::Auto => Encoding::Auto,
            EncodingArg::Png => Encoding::Png,
            EncodingArg::Bmp => Encoding::Bmp,
        },
        allow_upscale: !a.no_upscale,
    };
    // Fail fast on bad sizes instead of once per file.
    png2ico::normalize_sizes(&opts.sizes)?;

    let plan = Plan {
        layout: if a.single { Layout::Single } else { Layout::PerSize },
        out_dir: a.out_dir.clone(),
        output: a.output.clone(),
        force: a.force,
        dry_run: a.dry_run,
    };

    let results: Vec<_> = collected
        .files
        .par_iter()
        .map(|f| (f, convert_file(f, &opts, &plan)))
        .collect();

    let mut converted = 0usize;
    for (file, res) in results {
        match res {
            Ok(written) => {
                converted += 1;
                if !quiet {
                    println!("{}", file.display());
                    for w in written {
                        let verb = if a.dry_run { "would write" } else { "✓" };
                        println!(
                            "  {verb} {} ({} size{}, {})",
                            w.path.display(),
                            w.sizes.len(),
                            if w.sizes.len() == 1 { "" } else { "s" },
                            human(w.bytes)
                        );
                    }
                }
            }
            Err(e) => {
                failures += 1;
                eprintln!("  ✗ {}: {e}", file.display());
            }
        }
    }

    if !quiet {
        println!("\n{converted} converted, {failures} failed");
    }
    Ok(if failures == 0 { ExitCode::SUCCESS } else { ExitCode::FAILURE })
}

fn run_inspect(files: Vec<PathBuf>) -> Result<ExitCode> {
    let mut failed = false;
    for f in files {
        let data = match std::fs::read(&f) {
            Ok(d) => d,
            Err(e) => {
                eprintln!("✗ {}: {e}", f.display());
                failed = true;
                continue;
            }
        };
        match read_directory(&data) {
            Ok(entries) => {
                println!("{} ({} image{})", f.display(), entries.len(), if entries.len() == 1 { "" } else { "s" });
                for e in entries {
                    let fmt = match e.format {
                        EntryFormat::Png => "PNG",
                        EntryFormat::Bmp => "BMP",
                    };
                    println!("  {:>3}x{:<3}  {:>2} bpp  {}  {}", e.width, e.height, e.bits_per_pixel, fmt, human(u64::from(e.bytes)));
                }
            }
            Err(e) => {
                eprintln!("✗ {}: {e}", f.display());
                failed = true;
            }
        }
    }
    Ok(if failed { ExitCode::FAILURE } else { ExitCode::SUCCESS })
}

/// Allow the legacy `png2ico file.png` form by inserting `convert`.
fn preprocess_args() -> Vec<OsString> {
    let mut args: Vec<OsString> = std::env::args_os().collect();
    const KNOWN: &[&str] = &["convert", "inspect", "sizes", "completions", "help", "-h", "--help", "-V", "--version"];
    if let Some(first) = args.get(1) {
        let s = first.to_string_lossy();
        if !KNOWN.contains(&s.as_ref()) {
            args.insert(1, OsString::from("convert"));
        }
    }
    args
}

fn main() -> ExitCode {
    let args Vec<String>
    let cli = Cli::parse_from(preprocess_args());

    let level = if cli.quiet {
        Level::ERROR
    } else {
        match cli.verbose {
            0 => Level::WARN,
            1 => Level::INFO,
            2 => Level::DEBUG,
            _ => Level::TRACE,
        }
    };
    tracing_subscriber::fmt()
        .with_max_level(level)
        .with_target(false)
        .without_time()
        .with_writer(std::io::stderr)
        .init();

    let result = match cli.command {
        Command::Convert(a) => run_convert(a, cli.quiet),
        Command::Inspect { files } => run_inspect(files),
        Command::Sizes => {
            for (name, s) in [("all", SIZES_ALL), ("windows", SIZES_WINDOWS), ("favicon", SIZES_FAVICON)] {
                let list: Vec<String> = s.iter().map(|v| format!("{v}x{v}")).collect();
                println!("{name:<8} {}", list.join(" "));
            }
            Ok(ExitCode::SUCCESS)
        }
        Command::Completions { shell } => {
            clap_complete::generate(shell, &mut Cli::command(), "png2ico", &mut std::io::stdout());
            Ok(ExitCode::SUCCESS)
        }
    };

    match result.context("png2ico failed") {
        Ok(code) => code,
        Err(e) => {
            eprintln!("error: {e:#}");
            ExitCode::FAILURE
        }
    }
}
